PORT=3000
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/brainstack?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
# Comma-separated list of allowed frontend origins (no trailing slash). E.g.: https://brainstack.vercel.app
# Leave empty or set to * to automatically allow any requesting origin.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
